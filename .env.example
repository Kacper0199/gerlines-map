# Copy to .env and fill in. See docs/KEYS.md. Never commit .env.

# Identification sent in the User-Agent of every outbound request
APP_NAME=gerlines
APP_CONTACT=

# K1 DB API Marketplace: Timetables (Free), StaDa (Free4All), FaSta (Free4All)
DB_CLIENT_ID=
DB_API_KEY=

# K2 opentransportdata.swiss GTFS-RT (optional)
OTD_CH_API_KEY=
# opentransportdata.swiss Train Formation Service (optional, Swiss trains crossing into Germany)
OTD_CH_FORMATION_API_KEY=

# K3 Mobilithek machine account (optional): certificate file relative to the repository, its password from the SMS,
# and the Subscription-ID of the DELFI GTFS-RT subscription (My Subscriptions, Subscription Details)
# The recorder source delfi-mobilithek-rt runs when all three are set; the path is relative to the repository root.
MOBILITHEK_CERT_P12=secrets/mobilithek/gerlines-recorder.p12
MOBILITHEK_CERT_PASSWORD=
MOBILITHEK_DELFI_RT_SUBSCRIPTION_ID=

# Local infrastructure (defaults work with infra/compose.yaml)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=gerlines
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=gerlines
# Optional full URL for migrations and tests; when empty it is built from the POSTGRES_* values
DATABASE_URL=
VALKEY_PORT=6379
# Centrifugo (Compose profile live); local-only values, replace them on any shared machine
CENTRIFUGO_PORT=8000
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=change-me-locally
CENTRIFUGO_HTTP_API_KEY=change-me-locally
CENTRIFUGO_ADMIN_PASSWORD=change-me-locally
CENTRIFUGO_ADMIN_SECRET=change-me-locally

# Live engine (services/live, Compose profile live): host port, default 8790 (the API keeps 8787, a replay 8788)
LIVE_PORT=

# apps/api listening port, default 8787 (also when empty)
API_PORT=
# Proxies in front of apps/api whose forwarding headers name the client, for example 127.0.0.1,::1 behind Caddy (empty trusts nobody);
# with NODE_ENV=production the API refuses to start without it and API_CLOUDFLARE_RANGES (infra/compose.production.yaml sets both)
API_TRUSTED_PROXIES=
# Cloudflare edge ranges (CIDR list, comma separated) whose CF-Connecting-IP names the client; empty ignores that header
API_CLOUDFLARE_RANGES=
# Timetable database apps/api search reads; search answers 503 not_configured while empty
SEARCH_DATABASE_URL=
# Database apps/api statistics read (a read-only role is enough); SEARCH_DATABASE_URL when empty, 503 not_configured when both are
STATS_DATABASE_URL=
# Database the recorder writes, which the apps/api data status reads (a read-only role is enough, transactions open read only); STATS_ then SEARCH_DATABASE_URL when empty, 503 not_configured when all are
STATUS_DATABASE_URL=
# Places file of apps/api search, default data/search/places-de.tsv
SEARCH_PLACES_FILE=
# Absolute path to the B1 delay forecast table of gerlines-predict table (docs/predictions.md); train details carry forecast null while empty
PREDICTION_TABLE=
# Live store apps/api reads train details from (redis:// or rediss://); details answer 503 not_configured while empty
VALKEY_URL=
# Database with the catalogue and fleet rules for vehicle identity; details carry vehicle null while empty
VEHICLE_DATABASE_URL=
# 1 lets apps/api fetch the bahn.de coach sequence in the background (off by default, D-060)
VEHICLE_SEQUENCE_ENABLED=
# Absolute path to the folder of the local photo copies (data/photos); details keep photo null while empty
PHOTO_DIR=

# Router (services/router, Compose profile router; MOTIS 2.11.4 on 127.0.0.1 only)
ROUTER_BASE_URL=http://127.0.0.1:8092
ROUTER_PORT=
# MOTIS dataset tag the journeys API treats as domestic (default de-DELFI)
ROUTER_DATASET_TAG=
# MOTIS run folder with data/ and container.yml (default ../data/router/runs/delfi-2026-10-19-rail relative to infra/)
ROUTER_RUN_DIR=

# Recorder (services/ingest, Compose profile recorder)
# SNCB open data member key, sent only in the bmc-partner-key header; both SNCB sources are skipped while empty
SNCB_API_KEY=
# 1 polls IRIS, StaDa and FaSta with the K1 keys above (one IRIS poller at a time, lease in the recordings folder), 0 or empty does not
RECORDER_DB_APIS=0
# Host folder for recordings (default ../data/recordings relative to infra/), static seeds, and the free disk floor
RECORDINGS_DIR=
RECORDER_SEED_DIR=
RECORDER_DISK_FLOOR_GIB=

# Publishing only (milestone M10). The production server reads its own env file, made from
# infra/production/production.env.example (docs/runbooks/deploy.md), never this one
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
TILES_BASE_URL=
HCLOUD_TOKEN=
GLITCHTIP_DSN=
