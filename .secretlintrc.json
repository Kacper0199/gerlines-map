{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "DB API Marketplace client id or API key",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])DB_(?:CLIENT_ID|API_KEY)[\"']?[ \\t]*[=:][ \\t]*[\"']?[0-9A-Fa-f]{32}(?![0-9A-Za-z])/m",
              "/DB-(?:Client-Id|Api-Key)[\"']?[ \\t]*[:=,][ \\t]*[\"']?[0-9A-Fa-f]{32}(?![0-9A-Za-z])/i"
            ]
          },
          {
            "name": "opentransportdata.swiss API key",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])OTD_CH_(?:FORMATION_)?API_KEY[\"']?[ \\t]*[=:][ \\t]*[\"']?[^\\s\"'#$<{][^\\s\"'#]{15,}/m",
              "/Bearer[ \\t]+eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}/"
            ]
          },
          {
            "name": "Cloudflare and R2 credential",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])(?:CLOUDFLARE_API_TOKEN|R2_ACCESS_KEY_ID|R2_SECRET_ACCESS_KEY)[\"']?[ \\t]*[=:][ \\t]*[\"']?[^\\s\"'#$<{][^\\s\"'#]{15,}/m"
            ]
          },
          {
            "name": "Hetzner Cloud token",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])HCLOUD_TOKEN[\"']?[ \\t]*[=:][ \\t]*[\"']?[^\\s\"'#$<{][^\\s\"'#]{15,}/m"
            ]
          },
          {
            "name": "GlitchTip or Sentry DSN with key",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])GLITCHTIP_DSN[\"']?[ \\t]*[=:][ \\t]*[\"']?https?:\\/\\/[^\\s\"'@\\/$<{][^\\s\"'@\\/]*@/m",
              "/https?:\\/\\/[0-9a-f]{32}@[^\\s\"'\\/]+\\/[0-9]+/"
            ]
          },
          {
            "name": "Postgres password",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])POSTGRES_PASSWORD[\"']?[ \\t]*[=:][ \\t]*[\"']?[^\\s\"'#$<{\\\\][^\\s\"'#\\\\]*/m"
            ],
            "allows": [
              "/[=:][ \\t]*[\"']?change-me-locally[\"']?$/",
              "/:-change-me-locally\\}$/",
              "/[=:][ \\t]*[\"']?(?:os\\.environ|os\\.getenv|process\\.env)/",
              "/POSTGRES_PASSWORD[\"']?[ \\t]*:\\?/"
            ]
          },
          {
            "name": "Production database password (owner or API role)",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])(?:DB_OWNER_PASSWORD|API_DB_PASSWORD)[\"']?[ \\t]*[=:][ \\t]*[\"']?[^\\s\"'#$<{,;()?/\\\\][^\\s\"',;()\\\\]{7,}/m"
            ],
            "allows": [
              "/[=:\\s][\"']?[A-Z][A-Z0-9]*_[A-Z0-9_]*$/",
              "/[=:][ \\t]*[\"']?(?:os\\.environ|os\\.getenv|process\\.env)/"
            ]
          },
          {
            "name": "SNCB (Belgian Mobility Company) API key",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])SNCB_API_KEY[\"']?[ \\t]*[=:][ \\t]*[\"']?[0-9A-Fa-f]{32}(?![0-9A-Za-z])/m",
              "/bmc-partner-key[\"']?[ \\t]*[:=,][ \\t]*[\"']?[0-9A-Fa-f]{32}(?![0-9A-Za-z])/i"
            ]
          },
          {
            "name": "Mobilithek client certificate password",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])MOBILITHEK_CERT_PASSWORD[\"']?(?:[ \\t]*=[ \\t]*|[ \\t]*:[ \\t]+)[\"']?[^\\s\"'#$<{%\\\\][^\\s\"'#\\\\]*/m"
            ],
            "allows": ["/[=:][ \\t]*[\"']?(?:os\\.environ|os\\.getenv|process\\.env)/"]
          },
          {
            "name": "PKCS 12 client certificate file",
            "filePathGlobs": ["**/*.p12", "**/*.P12", "**/*.pfx", "**/*.PFX"]
          },
          {
            "name": "Centrifugo API key, admin password, admin secret or token HMAC secret",
            "patterns": [
              "/(?:^|[^A-Za-z0-9_.])CENTRIFUGO_(?:HTTP_API_KEY|ADMIN_PASSWORD|ADMIN_SECRET|CLIENT_TOKEN_HMAC_SECRET_KEY)[\"']?[ \\t]*[=:][ \\t]*[\"']?[^\\s\"'#$<{,;()\\\\][^\\s\"',;()\\\\]{7,}/m"
            ],
            "allows": [
              "/[=:][ \\t]*[\"']?-?change-me-locally\\}?[\"']?$/",
              "/[=:\\s][\"']?[A-Z][A-Z0-9]*_[A-Z0-9_]*$/",
              "/[=:][ \\t]*[\"']?(?:os\\.environ|os\\.getenv|process\\.env)/"
            ]
          },
          {
            "name": "Centrifugo secret in a config file",
            "patterns": [
              "/(?:(?:^|[^A-Za-z0-9.])(?:hmac_secret_key|admin_password|admin_secret)[\"']?[ \\t]*[=:][ \\t]*[\"']?|\"(?:http_api|admin)\"[ \\t]*:[ \\t]*\\{[^{}]*?\"(?:key|password|secret)\"[ \\t]*:[ \\t]*\"|^[ \\t]*(?:http_api|admin):[ \\t]*\\r?\\n(?:[ \\t]+[^\\s#][^\\n]*\\n)*?[ \\t]+(?:key|password|secret):[ \\t]*[\"']?)[^\\s\"'#$<{,;()\\\\][^\\s\"',;()\\\\]{7,}/m"
            ],
            "allows": [
              "/[=:\"][ \\t]*[\"']?-?change-me-locally\\}?[\"']?$/",
              "/[=:\\s][\"']?[A-Z][A-Z0-9]*_[A-Z0-9_]*$/",
              "/[=:][ \\t]*[\"']?(?:os\\.environ|os\\.getenv|process\\.env)/"
            ]
          },
          {
            "name": "Valkey password or masterauth",
            "patterns": [
              "/(?:(?:^|[^A-Za-z0-9_.])VALKEY_PASSWORD[\"']?[ \\t]*[=:][ \\t]*[\"']?|(?:^[ \\t]*|[ \\t]--)(?:requirepass|masterauth)[ \\t]+[\"']?|(?:redis|rediss|valkey|valkeys):\\/\\/[^\\s:@\\/\"']*:)[^\\s\"'#$<{,;()@\\/\\\\][^\\s\"',;()@\\\\]{7,}/m"
            ],
            "allows": [
              "/(?:[=:]|requirepass|masterauth)[ \\t]*[\"']?-?change-me-locally\\}?[\"']?$/",
              "/[=:\\s][\"']?[A-Z][A-Z0-9]*_[A-Z0-9_]*$/",
              "/[=:][ \\t]*[\"']?(?:os\\.environ|os\\.getenv|process\\.env)/"
            ]
          },
          {
            "name": "Valkey ACL password",
            "patterns": [
              "/(?:^[ \\t]*user|[ \\t][Aa][Cc][Ll])[ \\t]+(?:[Ss][Ee][Tt][Uu][Ss][Ee][Rr][ \\t]+)?[^\\s>]+(?:[ \\t]+[^\\s>]+)*?[ \\t]+>[^\\s\"'$<{][^\\s\"']{7,}/m"
            ],
            "allows": ["/>-?change-me-locally$/"]
          }
        ]
      }
    }
  ]
}
