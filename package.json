{
  "name": "gerlines",
  "version": "0.0.0",
  "private": true,
  "description": "Live 3D map of every train in Germany",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.28.8+sha512.f6988a32046b9a3f78d7d7ee0747926bbe905ff9dff73bf19abb87bd7d1906a2ac90d93f73be32b5f9e14c2899569bcb0c9c5ec8a19e083f5d71bbab6dd9e0b8",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint typecheck test",
    "db:migrate": "pnpm --filter @gerlines/db db:migrate",
    "db:reset": "pnpm --filter @gerlines/db db:reset",
    "db:rollback": "pnpm --filter @gerlines/db db:rollback",
    "db:status": "pnpm --filter @gerlines/db db:status",
    "db:test": "pnpm --filter @gerlines/db test:integration",
    "db:types": "pnpm --filter @gerlines/db db:types",
    "format": "biome check --write .",
    "hooks:install": "lefthook install",
    "infra:down": "bash infra/compose.sh --profile live --profile realtime --profile recorder --profile router down",
    "infra:logs": "bash infra/compose.sh --profile live --profile realtime --profile recorder --profile router logs --follow --tail=200",
    "infra:ps": "bash infra/compose.sh --profile live --profile realtime --profile recorder --profile router ps",
    "infra:psql": "bash infra/compose.sh exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "infra:up": "bash infra/compose.sh up -d --wait",
    "infra:up:live": "bash infra/compose.sh --profile live up -d --wait db valkey centrifugo",
    "lint": "turbo run lint",
    "live:packs": "bash infra/compose.sh --profile live run --rm live packs build --out /live",
    "live:up": "bash infra/compose.sh --profile live up -d live",
    "lint:copy": "node scripts/lint-copy.ts",
    "lint:root": "biome check --files-ignore-unknown=true --no-errors-on-unmatched package.json turbo.json biome.json .secretlintrc.json .gitleaks.toml .vscode scripts",
    "recorder:logs": "bash infra/compose.sh --profile recorder logs --follow --tail=200 recorder",
    "recorder:status": "docker exec gerlines-recorder-1 node /app/recorder.mjs status",
    "recorder:up": "bash infra/compose.sh --profile recorder up -d --build --wait recorder",
    "router:up": "bash infra/compose.sh --profile router up -d --wait router",
    "secrets:scan": "secretlint \"**/*\"",
    "secrets:staged": "bash scripts/scan-staged-secrets.sh",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "deploy:check": "bash scripts/check-deploy.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@secretlint/secretlint-rule-pattern": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "lefthook": "catalog:",
    "secretlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
