{
  "cases": [
    {
      "name": "statements with their terminators",
      "sql": "CREATE TABLE a (id int);\nDROP TABLE b;\n",
      "statements": ["CREATE TABLE a (id int);", "DROP TABLE b;"]
    },
    {
      "name": "a last statement without a semicolon",
      "sql": "SELECT 1;\nSELECT 2\n",
      "statements": ["SELECT 1;", "SELECT 2"]
    },
    {
      "name": "parts that hold only comments or whitespace",
      "sql": "-- header\n;\n/* note */\nSELECT 1;\n-- trailing\n",
      "statements": ["/* note */\nSELECT 1;"]
    },
    {
      "name": "a string literal with a doubled quote",
      "sql": "SELECT 'a;b''c;';\nSELECT 2;",
      "statements": ["SELECT 'a;b''c;';", "SELECT 2;"]
    },
    {
      "name": "an escape string",
      "sql": "SELECT E'it\\'s;';\nSELECT 2;",
      "statements": ["SELECT E'it\\'s;';", "SELECT 2;"]
    },
    {
      "name": "a lowercase escape string",
      "sql": "SELECT e'a\\\\';\nSELECT 2;",
      "statements": ["SELECT e'a\\\\';", "SELECT 2;"]
    },
    {
      "name": "a word ending in E before a quote",
      "sql": "SELECT abcE'a\\';\nSELECT 2;",
      "statements": ["SELECT abcE'a\\';", "SELECT 2;"]
    },
    {
      "name": "a quoted identifier",
      "sql": "SELECT 1 AS \"x;\"\"y\";\nSELECT 2;",
      "statements": ["SELECT 1 AS \"x;\"\"y\";", "SELECT 2;"]
    },
    {
      "name": "a line comment",
      "sql": "SELECT 1 -- not; here\n;\nSELECT 2;",
      "statements": ["SELECT 1 -- not; here\n;", "SELECT 2;"]
    },
    {
      "name": "a nested block comment",
      "sql": "SELECT /* a /* b; */ c; */ 1;\nSELECT 2;",
      "statements": ["SELECT /* a /* b; */ c; */ 1;", "SELECT 2;"]
    },
    {
      "name": "a tagged dollar body",
      "sql": "CREATE FUNCTION f() RETURNS int LANGUAGE plpgsql AS $fn$ BEGIN RETURN 1; END $fn$;\nSELECT 2;",
      "statements": [
        "CREATE FUNCTION f() RETURNS int LANGUAGE plpgsql AS $fn$ BEGIN RETURN 1; END $fn$;",
        "SELECT 2;"
      ]
    },
    {
      "name": "an anonymous dollar body",
      "sql": "DO $$ BEGIN PERFORM 1; END $$;\nSELECT 2;",
      "statements": ["DO $$ BEGIN PERFORM 1; END $$;", "SELECT 2;"]
    },
    {
      "name": "a positional parameter",
      "sql": "PREPARE p AS SELECT $1;\nSELECT 2;",
      "statements": ["PREPARE p AS SELECT $1;", "SELECT 2;"]
    },
    {
      "name": "a dollar sign inside an identifier",
      "sql": "SELECT 1 AS a$$b;\nSELECT 2;",
      "statements": ["SELECT 1 AS a$$b;", "SELECT 2;"]
    },
    {
      "name": "the no-transaction directive",
      "sql": "-- gerlines:no-transaction\nCALL refresh_continuous_aggregate('a', NULL, (now() + INTERVAL '7 days')::date);\nSELECT 2;\n",
      "statements": [
        "-- gerlines:no-transaction\nCALL refresh_continuous_aggregate('a', NULL, (now() + INTERVAL '7 days')::date);",
        "SELECT 2;"
      ]
    },
    {
      "name": "an unterminated string",
      "sql": "SELECT 'a;\nSELECT 2;",
      "statements": ["SELECT 'a;\nSELECT 2;"]
    }
  ],
