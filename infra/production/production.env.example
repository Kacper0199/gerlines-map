# Production env file for infra/compose.production.yaml (docs/runbooks/deploy.md). Copy to the server as
# /etc/gerlines/production.env (mode 600, owned by the deploy user), fill in, never commit it.
# Secrets: 32 random bytes as hex each (openssl rand -hex 32); hex keeps them safe inside the URLs built from them.
# Every variable below is required: Compose stops with "required variable ... is missing" when one is empty.

# Site
PUBLIC_HOST=
APP_NAME=gerlines
APP_CONTACT=

# Database (owner role of the gerlines database: recorder, realtime, live, migrations); the overlay hands
# DB_OWNER_PASSWORD to the containers as POSTGRES_PASSWORD
POSTGRES_USER=gerlines
DB_OWNER_PASSWORD=
POSTGRES_DB=gerlines
# Read-only role the API reads with (SQL in the runbook)
API_DB_USER=gerlines_api
API_DB_PASSWORD=

# Valkey (requirepass; the URLs of api and live are built from it)
VALKEY_PASSWORD=

# Centrifugo (connect by token only, admin off)
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=
CENTRIFUGO_HTTP_API_KEY=

# Cloudflare edge ranges: bash infra/production/cloudflare-ranges.sh env >> /etc/gerlines/production.env
CLOUDFLARE_RANGES=
API_CLOUDFLARE_RANGES=

# Host folders (absolute paths on the server)
WEB_DIST_DIR=
EDGE_TLS_DIR=
API_DATA_DIR=
LIVE_DIR=
RECORDINGS_DIR=
RECORDER_SEED_DIR=
REALTIME_STATE_DIR=
ROUTER_RUN_DIR=

# Optional recorder keys (docs/KEYS.md); an empty key leaves its source off
DB_CLIENT_ID=
DB_API_KEY=
OTD_CH_API_KEY=
SNCB_API_KEY=
MOBILITHEK_CERT_PASSWORD=
MOBILITHEK_DELFI_RT_SUBSCRIPTION_ID=
RECORDER_DB_APIS=0
# Optional: B1 forecast table inside API_DATA_DIR as the container sees it, for example /data/predictions/b1-2026-08-2026-10.json.gz (about 470 MB more API memory, docs/predictions.md)
PREDICTION_TABLE=
