{
  "name": "@gerlines/live",
  "version": "0.1.0",
  "private": true,
  "description": "Motion plans, keyframes and deltas for clients",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "live": "node --env-file-if-exists=../../.env src/cli.ts",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run --test-timeout=120000 --hook-timeout=120000 integration",
    "typecheck": "tsc",
    "detail": "node --env-file-if-exists=../../.env src/detail/cli.ts"
  },
  "dependencies": {
    "@gerlines/db": "workspace:*",
    "@gerlines/geo": "workspace:*",
    "@gerlines/live-frame": "workspace:*",
    "@gerlines/schema": "workspace:*",
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "iovalkey": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@gerlines/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
