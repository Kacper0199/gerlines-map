{
  "name": "@gerlines/web",
  "version": "0.0.0",
  "private": true,
  "description": "Web client: map, panels, motion worker",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "e2e": "GERLINES_TRAIN_MODELS=off vite build && playwright test",
    "e2e:update": "GERLINES_TRAIN_MODELS=off vite build && playwright test --update-snapshots=missing e2e/tests/visual.spec.ts",
    "e2e:server": "node e2e/server/fixture-server.ts",
    "lint": "biome check .",
    "identical-bodies": "node scripts/build-identical-bodies.ts && biome format --write src/cars/identical-bodies.generated.ts",
    "operator-groups": "node scripts/build-operator-groups.ts && biome format --write src/modes/operator-groups.generated.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc && tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@deck.gl/core": "catalog:",
    "@deck.gl/layers": "catalog:",
    "@deck.gl/maplibre": "catalog:",
    "@deck.gl/mesh-layers": "catalog:",
    "@gerlines/geo": "workspace:*",
    "@gerlines/i18n": "workspace:*",
    "@gerlines/live-frame": "workspace:*",
    "@gerlines/schema": "workspace:*",
    "@gerlines/ui": "workspace:*",
    "@loaders.gl/core": "catalog:",
    "@luma.gl/core": "catalog:",
    "@luma.gl/engine": "catalog:",
    "lucide-react": "catalog:",
    "maplibre-gl": "catalog:",
    "meshoptimizer": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@gerlines/api": "workspace:*",
    "@gerlines/config": "workspace:*",
    "@hono/node-server": "catalog:",
    "@mapbox/vector-tile": "3.0.0",
    "@maplibre/maplibre-gl-style-spec": "catalog:",
    "@maplibre/vt-pbf": "4.3.3",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "catalog:",
    "happy-dom": "catalog:",
    "js-yaml": "catalog:",
    "oxc-transform-react": "catalog:",
    "pbf": "5.1.2",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
